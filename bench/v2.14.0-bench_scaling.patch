   for (int nAtoms : sizes) {
     Cloud cloud = makeCloud(nAtoms, typeI);
-    const int reps = nAtoms <= 4000 ? 5 : 3;

     std::vector<std::vector<int>> nList;
-    const double tNeigh = bestMillis(
