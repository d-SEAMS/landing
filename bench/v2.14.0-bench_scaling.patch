Measurement change to seams-core v2.14.0 tests/bench_scaling.cpp for the
neighbour list, ring index and CHILL+ rows. The released driver prints the
minimum of an internal loop; with this patch it makes seven calls per stage
and prints each one. Apply from a v2.14.0 checkout with git apply.

diff --git a/tests/bench_scaling.cpp b/tests/bench_scaling.cpp
index cb47e05..f22507a 100644
--- a/tests/bench_scaling.cpp
+++ b/tests/bench_scaling.cpp
@@ -74,20 +74,29 @@ Cloud makeCloud(int nAtoms, int typeI) {
   return cloud;
 }

-/// Runs @a fn @a reps times and returns the best wall time in milliseconds.
-/// The minimum is reported rather than the mean because a loaded machine adds
-/// only positive noise.
-template <typename Fn> double bestMillis(Fn &&fn, int reps) {
-  double best = std::numeric_limits<double>::max();
+/// Wall time of each call, in milliseconds. The distributed driver reduces
+/// these to a minimum; this measurement build keeps every call.
+template <typename Fn>
+std::vector<double> sampleMillis(Fn &&fn, int reps) {
+  std::vector<double> samples;
+  samples.reserve(static_cast<std::size_t>(reps));
   for (int rep = 0; rep < reps; rep++) {
     const auto start = std::chrono::steady_clock::now();
     fn();
     const auto end = std::chrono::steady_clock::now();
-    const double ms =
-        std::chrono::duration<double, std::milli>(end - start).count();
-    best = std::min(best, ms);
+    samples.push_back(
+        std::chrono::duration<double, std::milli>(end - start).count());
+  }
+  return samples;
+}
+
+void printSamples(int nAtoms, const char *stage,
+                  const std::vector<double> &samples) {
+  std::cout << std::fixed << std::setprecision(6);
+  for (std::size_t rep = 0; rep < samples.size(); rep++) {
+    std::cout << nAtoms << " " << stage << " " << rep << " " << samples[rep]
+              << "\n";
   }
-  return best;
 }

 } // namespace
